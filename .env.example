# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The single number all test calls originate from (E.164). Must match the
# number declared on the submission form.
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Target under test (Pretty Good AI assessment line). Do not change. ---
TARGET_NUMBER=+18054398008

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
REALTIME_MODEL=gpt-realtime-2
# Mu-law codec type for the Twilio media stream. Confirmed against the live API
# with tools/probe_realtime.py -- note it is NOT the "g711_ulaw" of the beta API.
REALTIME_AUDIO_FORMAT_TYPE=audio/pcmu

# --- ngrok ---
NGROK_AUTHTOKEN=your_ngrok_authtoken
LOCAL_PORT=8000
